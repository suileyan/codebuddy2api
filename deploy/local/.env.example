# workbuddy2api 本地原生部署配置
# 复制为同目录下的 .env 后填写；.env 已被 .gitignore 忽略，不会提交。
# 启动：start.cmd（Windows）或 bash start.sh

# 管理后台密钥。服务仅监听 127.0.0.1，但仍请改成自己的随机串（至少 8 位）。
ADMIN_KEY=

# 初始客户端 API Key。首次启动后可在后台「API 密钥」里增删。
CODEBUDDY2OPENAI_KEY=

# 登录态目录。建议用本部署专用目录（由 import_accounts.py 导入），
# 不要去读写桌面客户端自己的目录。
CODEBUDDY_AUTH_DIR=

# WorkBuddy 可执行文件路径。5.6.0+ 的登录态是 $wbEncrypted 加密的，
# 需要用它来解密；国内版与国际版填各自安装路径。
WORKBUDDY_ELECTRON_PATH=

# 管理后台持久化目录（账号索引、客户端 Key 摘要、日志）。
MANAGEMENT_DATA_DIR=

# 监听配置，默认仅本机回环。
HOST=127.0.0.1
PORT=8787
